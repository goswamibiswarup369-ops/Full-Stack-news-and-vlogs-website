# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=[ ]

# --- Scheduler (timezone Asia/Kolkata) ---
ENABLE_SCHEDULER=true
TIMEZONE=Asia/Kolkata
DAILY_CRON=0 6 * * *
BREAKING_CRON=*/30 * * * *
# set to 'false' to disable the frequent breaking-news refresh
ENABLE_BREAKING_REFRESH=true

# --- News providers ---
# NewsAPI.org (https://newsapi.org). NOTE: the free Developer plan is for development only; use a paid plan in production.
NEWSAPI_KEY=d5d7df8885a44493aaebf7dbb2117207
# Format: name|url|categorySlug , separated by commas. Verify each feed's URL and terms of use before enabling.
RSS_FEEDS=PIB|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3|national-affairs,RBI|https://www.rbi.org.in/pressreleases_rss.xml|economy-banking

# --- Later phases (placeholders) ---
JWT_SECRET=change_me_to_a_long_random_string
AI_API_KEY=your_ai_api_key_here
EMAIL_API_KEY=your_email_provider_key_here
